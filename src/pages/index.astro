---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GameList from '../components/GameList.astro';
import { getDatabase } from '../lib/db';
import { GAMES_PER_PAGE, getGamesPage } from '../lib/games';

export const prerender = true;

const { games, totalPages } = await getGamesPage(getDatabase(), 1, GAMES_PER_PAGE);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <GameList games={games} currentPage={1} totalPages={totalPages} />
  </div>
</Layout>
