---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex items-center" data-testid="game-rating" aria-label={`Rated ${clampRating(rating).toFixed(1)} out of 5 stars`}>
        <span class="sr-only">{clampRating(rating).toFixed(1)} out of 5 stars</span>
        <span class="rounded-full border border-amber-400/20 bg-amber-400/10 px-2.5 py-1 text-sm shadow-[0_0_18px_rgba(251,191,36,0.12)] transition-all duration-300 group-hover:border-amber-300/50 group-hover:bg-amber-400/15 group-hover:shadow-[0_0_24px_rgba(251,191,36,0.22)] motion-reduce:transition-none">
            <span class="text-amber-300 tracking-wide" aria-hidden="true">{formatStarRating(rating)}</span>
            <span class="ml-1 font-semibold text-amber-100">{clampRating(rating).toFixed(1)}</span>
        </span>
    </div>
)}
